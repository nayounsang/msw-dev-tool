{
  "name": "msw-dev-tool-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "msw": "2.7.3"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@msw-dev-tool/core --filter=@msw-dev-tool/cli-core --filter=@msw-dev-tool/react --filter=@msw-dev-tool/node-cli --filter=@msw-dev-tool/browser-cli --filter=msw-dev-tool",
    "build:docs": "turbo run build --filter=docs",
    "dev": "turbo run dev --filter=docs... --filter=example...",
    "dev:example": "turbo run dev --filter=example...",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "version-packages": "yarn changeset version && yarn install --mode=update-lockfile",
    "changeset": "changeset",
    "clean": "yarn workspace msw-dev-tool clean && yarn workspace docs clean && rm -rf node_modules",
    "resolve-workspace-protocol": "ts-node scripts/resolve-workspace-protocol.ts",
    "release": "yarn resolve-workspace-protocol && yarn build:packages && yarn changeset publish"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.5.3",
  "dependencies": {
    "@changesets/cli": "^2.28.1"
  }
}
