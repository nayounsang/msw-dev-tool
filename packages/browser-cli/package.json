{
  "name": "@msw-dev-tool/browser-cli",
  "version": "1.0.0",
  "description": "CDP CLI for AI agents to control browser msw-dev-tool sessions.",
  "bin": {
    "msw-dev-tool-browser": "./bin/msw-dev-tool-browser.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@msw-dev-tool/cli-core": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@msw-dev-tool/core": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.13",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@msw-dev-tool/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
